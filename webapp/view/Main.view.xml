<mvc:View
    controllerName="spm.controller.Main"
    xmlns:core="sap.ui.core"
    xmlns:filterbar="sap.ui.comp.filterbar"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt"
    xmlns:f='sap.f'
    xmlns:table='sap.ui.table'
    xmlns:commons="sap.suite.ui.commons"
>
    <Page id="page">
        <customHeader>
            <f:ShellBar
                title="Tổng Quan"
                showCopilot="true"
                showSearch="true"
                showNotifications="true"
                notificationsNumber="2"
            />
        </customHeader>

        <tnt:ToolHeader>
            <IconTabHeader
                id="iconTabHeader"
                selectedKey="invalidKey"
                backgroundDesign="Transparent"
                mode="Inline"
            >
                <layoutData>
                    <OverflowToolbarLayoutData
                        priority="NeverOverflow"
                        shrinkable="true"
                    />
                </layoutData>
                <items>
                    <IconTabFilter text="Tổng quan" />
                    <IconTabFilter text="Quản lý pr" />
                    <IconTabFilter text="Đơn mua hàng" />
                    <IconTabFilter text="Nhà cung cấp" />
                    <IconTabFilter
                        text="Chấm điểm"
                        interactionMode="SelectLeavesOnly"
                    >
                        <items>
                            <IconTabFilter text="Tiêu chí chấm điểm" />
                        </items>
                    </IconTabFilter>
                    <IconTabFilter
                        text="Phòng ban"
                        interactionMode="SelectLeavesOnly"
                    >
                        <items>
                            <IconTabFilter text="Phòng ban" />
                        </items>
                    </IconTabFilter>

                    <IconTabFilter text="Quản lý biểu mẫu" />
                    <IconTabFilter text="Trò chuyện" />
                </items>
            </IconTabHeader>
        </tnt:ToolHeader>
        <content>
            <IconTabBar class="sapUiSmallMarginTop">
                <items>
                    <IconTabFilter
                        design="Horizontal"
                        icon="sap-icon://group"
                        key="people"
                        count="53 of 132"
                        text="Nhà cung cấp hiện hữu"
                    />
                    <IconTabFilter
                        design="Horizontal"
                        icon="sap-icon://group"
                        key="people"
                        count="53 of 132"
                        text="Nhà cung cấp mới"
                    />
                </items>
            </IconTabBar>
            <Table
                items="{table>/rows}"
                class="sapFDynamicPageAlignContent"
                busy="false"
                mode="MultiSelect"
                itemPress="onListItemPress"

            >
                <headerToolbar>
                    <OverflowToolbar class="sapMTBHeader-CTX">
                        <Label
                            design="Bold"
                            text="Danh sách nhà cung cấp hiện hữu"
                        />
                        <ToolbarSpacer />

                        <SearchField
                            width="200px"
                            placeholder="search"
                        />
                        <Button
                            text="Kich hoạt"
                            type="Emphasized"
                        />
                        <Button
                            text="vô hiệu hóa"
                            type="Reject"
                        />
                        <ToolbarSeparator />
                        <OverflowToolbarButton
                            icon="sap-icon://action-settings"
                            id="enterSettingBtn"
                            press="handleSetting"
                        />
                        <ToolbarSeparator />

                        <OverflowToolbarButton
                            icon="sap-icon://excel-attachment"
                            id="enterAttachmentBtn"
                            press="handleAttachment"
                        />
                        <ToolbarSeparator />
                        <OverflowToolbarButton
                            icon="sap-icon://full-screen"
                            press="handleFullScreen"
                            id="enterFullScreenBtn"
                            visible="{= ${/actionButtonsInfo/midColumn/fullScreen} !== null }"
                        />
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column >
                        <Text text="Thông tin"   />
                    </Column>
                    <Column width="8rem">
                        <Text text="Công ty" />
                    </Column>
                    <Column>
                        <Text text="Cập nhật đăng ký" />
                    </Column>
                    <Column>
                        <Text text="Đánh giá đơn hàng" />
                    </Column>
                    <Column
                        hAlign="End"
                        width="8rem"
                    >
                        <Text text="Điểm năng lực" />
                    </Column>
                    <Column hAlign="End">
                        <Text text="Địa chỉ" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem type="Navigation" >
                        <cells>
                            <VBox>
                                <Link text="{table>thongTin/id}" />
                                <HBox>
                                    <Text text="Trạng thái: " />

                                    <Text text="{table>thongTin/trangThai}" />
                                    <customData>
                                        <core:CustomData
                                            key="color"
                                            value="{= ${table>thongTin/trangThai} === 'vô hiệu hóa' ? 'red' : 'green'}"
                                        />
                                    </customData>
                                </HBox>
                                <Text
                                    text="Lượt cung ứng: {table>thongTin/luotCungUng}"
                                />

                                <Text
                                    text="Ngày cập nhật đăng ký: {table>thongTin/NgayCapNhatDangKy}"
                                />
                            </VBox>
                        </cells>
                        <cells>
                            <ObjectIdentifier text="{table>congTy}" />
                        </cells>
                        <cells>
                            <commons:MicroProcessFlow>
                                <commons:content>
                                    <commons:MicroProcessFlowItem
                                        state="{table>capNhatDangKy}"
                                    />
                                    <commons:MicroProcessFlowItem
                                        state="Success"
                                    />
                                    <commons:MicroProcessFlowItem
                                        state="{table>capNhatDangKy}"
                                    />
                                </commons:content>
                            </commons:MicroProcessFlow>
                        </cells>
                        <cells>
                            <RatingIndicator
                                id="RI_default"
                                maxValue="5"
                                class="sapUiSmallMarginBottom"
                                value="{table>danhGiaDonHang}"
                            />
                        </cells>
                        <cells>
                            <ObjectIdentifier text="{table>diemNangLuc}" />
                        </cells>
                        <cells>
                            <ObjectIdentifier text="{table>diaChi}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
            
        </content>
        
    </Page>
</mvc:View>
