<mvc:View
    xmlns:unified="sap.ui.unified"
    controllerName="spm.controller.Main"
    xmlns:core="sap.ui.core"
    xmlns:filterbar="sap.ui.comp.filterbar"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt"
    xmlns:f='sap.f'
    xmlns:table='sap.ui.table'
    xmlns:svm="sap.ui.comp.smartvariants"
>
    <Page id="page">
        <customHeader>
            <f:ShellBar
                title="Tổng Quan"
                showCopilot="true"
                showSearch="true"
                showNotifications="true"
                notificationsNumber="2"
            />
        </customHeader>

        <tnt:ToolHeader>
            <IconTabHeader
                id="iconTabHeader"
                selectedKey="invalidKey"
                backgroundDesign="Transparent"
                mode="Inline"
            >
                <layoutData>
                    <OverflowToolbarLayoutData
                        priority="NeverOverflow"
                        shrinkable="true"
                    />
                </layoutData>
                <items>
                    <IconTabFilter text="Tổng quan" />
                    <IconTabFilter text="Quản lý pr" />
                    <IconTabFilter text="Đơn mua hàng" />
                    <IconTabFilter text="Nhà cung cấp" />
                    <IconTabFilter
                        text="Chấm điểm"
                        interactionMode="SelectLeavesOnly"
                    >
                        <items>
                            <IconTabFilter text="Tiêu chí chấm điểm" />
                        </items>
                    </IconTabFilter>
                    <IconTabFilter
                        text="Phòng ban"
                        interactionMode="SelectLeavesOnly"
                    >
                        <items>
                            <IconTabFilter text="Phòng ban" />
                        </items>
                    </IconTabFilter>

                    <IconTabFilter text="Quản lý biểu mẫu" />
                    <IconTabFilter text="Trò chuyện" />
                </items>
            </IconTabHeader>
        </tnt:ToolHeader>
        <content>
            <VBox>
                <HBox>
                    <GenericTile
                        class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout"
                        header="PR"
                        subheader="Mới đồng bộ"
                        press="press"
                        width="300px"
                    >
                        <TileContent
                            unit="Now"
                            footer="Footer"
                        >
                            <NumericContent
                                value="65.5%"
                                icon="sap-icon://line-charts"
                                withMargin="false"
                                valueColor="Good"
                            />
                        </TileContent>
                    </GenericTile>

                    <GenericTile
                        class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout"
                        header="PR"
                        subheader="Đã hủy"
                        press="press"
                        width="300px"
                    >
                        <TileContent
                            unit="Now"
                            visible="true"
                            footer="Footer"
                        >
                            <NumericContent
                                value="65.5%"
                                icon="sap-icon://line-charts"
                                withMargin="false"
                                valueColor="Good"
                            />
                        </TileContent>
                    </GenericTile>
                </HBox>
                <ToolbarSpacer />
                <Label text="Danh sách PR" />
            </VBox>
        </content>
        <f:DynamicPage headerExpanded="{/headerExpanded}">
            <f:title>
                <f:DynamicPageTitle>
                    <f:heading>
                        <svm:SmartVariantManagement
                            id="svm"
                            showExecuteOnSelection="true"
                        />
                    </f:heading>
                    <f:expandedContent>
                        <Label
                            id="expandedLabel"
                            text="No filters active"
                        />
                    </f:expandedContent>
                    <f:snappedContent>
                        <Label
                            id="snappedLabel"
                            text="No filters actives"
                        />
                    </f:snappedContent>
                </f:DynamicPageTitle>
            </f:title>
            <f:header>
                <f:DynamicPageHeader>
                    <f:content>
                        <filterbar:FilterBar
                            id="filterbar"
                            persistencyKey="myPersKey"
                            useToolbar="false"
                            search=".onSearch"
                            filterChange=".onFilterChange"
                            afterVariantLoad=".onAfterVariantLoad"
                        >
                            <filterbar:filterGroupItems>
                                <filterbar:FilterGroupItem
                                    name="startDate"
                                    label="Từ ngày"
                                    groupName="Group1"
                                    visibleInFilterBar="true"
                                >
                                    <filterbar:control>
                                        <DatePicker
                                            id="startDate"
                                            placeholder="startDate"
                                            change=".onChangeSelect"
                                        />
                                    </filterbar:control>
                                </filterbar:FilterGroupItem>
                                <filterbar:FilterGroupItem
                                    name="endDate"
                                    label="Đến ngày"
                                    groupName="Group1"
                                    visibleInFilterBar="true"
                                >
                                    <filterbar:control>
                                        <DatePicker
                                            id="endDate"
                                            placeholder="endDate"
                                            change="onChangeSelect"
                                        />
                                    </filterbar:control>
                                </filterbar:FilterGroupItem>

                                <filterbar:FilterGroupItem
                                    name="search"
                                    groupName="Group1"
                                    visibleInFilterBar="true"
                                >
                                    <filterbar:control>
                                        <SearchField change=".onChangeSelect" />
                                    </filterbar:control>
                                </filterbar:FilterGroupItem>

                                <filterbar:FilterGroupItem
                                    name="DeleteId"
                                    label="DeleteId"
                                    groupName="Group1"
                                    visibleInFilterBar="true"
                                >
                                    <filterbar:control>
                                        <MultiComboBox
                                            name="DeleteID"
                                            selectionChange=".onChangeSelect"
                                            items="{selectID>/DeleteID}"
                                        >
                                            <core:Item
                                                key="{selectID>key}"
                                                text="{selectID>value}"
                                            />
                                        </MultiComboBox>
                                    </filterbar:control>
                                </filterbar:FilterGroupItem>
                            </filterbar:filterGroupItems>
                        </filterbar:FilterBar>
                    </f:content>
                </f:DynamicPageHeader>
            </f:header>
            <f:content>
                <table:Table
                    selectionMode="MultiToggle"
                    rows="{DataPR>/PR}"
                    id="table"
                    rowActionCount="2"
                    rowSelectionChange="onRowSelectionChange"
                >
                    <table:extension>
                        <OverflowToolbar class="sapMTBHeader-CTX">
                            <Title
                                id="title"
                                text="PR"
                            />
                            <ToolbarSpacer />
                            <Button
                                text="Add row"
                                icon="sap-icon://add"
                                type="Emphasized"
                                press=".onOpenAddPR"
                            />
                            <Button
                                text="Delete row"
                                icon="sap-icon://delete"
                                type="Reject"
                                press=".onDeletePRs"
                            />
                        </OverflowToolbar>
                    </table:extension>
                    <table:columns>
                        <table:Column>
                            <Label text="Employeeid" />
                            <table:template>
                                <Text text="{DataPR>Employeeid}" />
                            </table:template>
                        </table:Column>
                        <table:Column>
                            <Label text="Fullname" />
                            <table:template>
                                <Text text="{DataPR>Fullname}" />
                            </table:template>
                        </table:Column>
                        <table:Column>
                            <Label text="Gender" />
                            <table:template>
                                <Text text="{DataPR>Gender}" />
                            </table:template>
                        </table:Column>
                        <table:Column>
                            <Label text="StartDate" />
                            <table:template>
                                <DatePicker
                                    value="{
                                path: 'DataPR>StartDate',
                                type: 'sap.ui.model.type.Date',
								formatOptions: {source: {pattern: 'dd.MM.yyyy'}, pattern: 'dd.MM.yyyy'}
                            }"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column>
                            <Label text="Contracttype" />
                            <table:template>
                                <Text text="{DataPR>Contracttype}" />
                            </table:template>
                        </table:Column>
                        <table:Column>
                            <Label text="Birthdate" />
                            <table:template>
                                <DatePicker
                                    enabled="false"
                                    value="{
                                path: 'DataPR>Birthdate',
                                type: 'sap.ui.model.type.Date',
								formatOptions: {source: {pattern: 'dd.MM.yyyy'}, pattern: 'dd.MM.yyyy'}
                            }"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column>
                            <Label text="Address" />
                            <table:template>
                                <Text text="{DataPR>Address}" />
                            </table:template>
                        </table:Column>
                        <table:Column>
                            <Label text="Phone" />
                            <table:template>
                                <Text text="{DataPR>Phone}" />
                            </table:template>
                        </table:Column>
                        <table:Column>
                            <Label text="Plans" />
                            <table:template>
                                <Text text="{DataPR>Plans}" />
                            </table:template>
                        </table:Column>
                        <table:Column>
                            <Label text="Salary" />
                            <table:template>
                                <Text text="{DataPR>Salary}" />
                            </table:template>
                        </table:Column>
                        <table:Column>
                            <Label text="Detalis" />
                            <table:template>
                                <ObjectIdentifier
                                    title="Detalis"
                                    titleActive="true"
                                    titlePress="onOpenDetail"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column>
                        <Label text="Files" />
                        <table:template>
                            <Link
                                text="{DataPR>File}"
                                press="onOpenFile"
                            />
                        </table:template>
                    </table:Column>
                        <!-- <table:Column>
                            <Label text="Ngày cập nhật" />
                            <table:template>
                                <DatePicker
                                enabled="false"
                                
                                    value="{
                                path: 'DataPR>Birthdate',
                                type: 'sap.ui.model.type.Date',
								formatOptions: {source: {pattern: 'dd.MM.yyyy'}, pattern: 'dd.MM.yyyy'}
                            }"
                                />
                            </table:template>
                        </table:Column> -->
                    </table:columns>
                    <table:rowActionTemplate>
                        <table:RowAction>
                            <table:RowActionItem
                                type="Custom"
                                text="Edit"
                                icon="sap-icon://edit"
                                press=".onEditPR"
                            />
                            <table:RowActionItem
                                type="Delete"
                                icon="sap-icon://delete"
                                press=".onDeletePR"
                            />
                        </table:RowAction>
                    </table:rowActionTemplate>
                </table:Table>
            </f:content>
        </f:DynamicPage>
    </Page>
</mvc:View>
